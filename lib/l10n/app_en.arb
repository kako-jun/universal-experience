  "escalationConditionDryEyePersistent": "persistent pain or a change in vision",
  "@escalationConditionDryEyePersistent": {
    "description": "Escalation condition for dry eye (sensus condition string: 'persistent pain or a change in vision')."
  },
  "escalationConditionHearingSuddenOneEar": "a sudden drop in hearing, especially in one ear (possible sudden sensorineural hearing loss)",
  "@escalationConditionHearingSuddenOneEar": {
    "description": "Escalation condition shared by several hearing filters (sensus condition string, hearing-loss family, Emergency tier)."
