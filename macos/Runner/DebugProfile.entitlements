<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- ユーザー画像の読み込み (#78)。file_selector のファイル選択ダイアログが
	     開くファイルを読むために要る（読み取り専用、書き込みは行わない）。
	     ドラッグ＆ドロップ（desktop_drop）はドロップ操作自体がユーザーの
	     明示的な意図とみなされ、サンドボックス下でも追加の entitlement なしで
	     ドロップされたファイルを読める。 -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- PNG エクスポート (#64)。サンドボックス下の getDownloadsDirectory() は
	     コンテナ内 Data/Downloads を返し、実機ではそれが実 ~/Downloads への
	     シンボリックリンクになっている想定。この entitlement が無いとリンク先への
	     書き込みがサンドボックスに拒否される想定で、付けるとリンク経由で実
	     ~/Downloads に書ける（どちらも修正前の実機挙動は未検証）。表示・「フォルダ
	     で表示」に使うパスは resolveSymbolicLinks で実パスに揃える
	     （export_service.dart の savePng 参照）。 -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
